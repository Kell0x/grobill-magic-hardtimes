			y: 2.0d
		}
		{
			description: [
				"Certaines créatures appartiennent au passé, et vous vous êtes fait un devoir de vous en assurer."
				""
				"Les yeux parcourus d'électricité statique s'agitent dans votre sac, ils semblent prédire les orages ?"
			]
			id: "5B95F4B90C582EA3"
